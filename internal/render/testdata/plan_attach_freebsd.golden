01 ifconfig epair create; rename ends to joe49a245eed00a and joe49a245eed00b
02 ifconfig joe49a245eed00a ether 0a:7e:5e:ec:da:6d
03 ifconfig joe49a245eed00b ether ca:64:60:d0:bb:57
04 ifconfig joe49a245eed00a description jailops jail=web/nginx net=lan (host side)
05 ifconfig joe49a245eed00a mtu 1500
06 ifconfig joe49a245eed00b mtu 1500
07 ifconfig joe49a245eed00a inet 10.20.0.1/32 alias
08 ifconfig joe49a245eed00a inet6 fe80::1/64 alias
09 ifconfig joe49a245eed00a up
10 route add -inet 10.20.0.10/32 -interface joe49a245eed00a
11 route add -inet6 2001:db8:1::100/128 -interface joe49a245eed00a
12 [host, jail] ifconfig -j <jail> joe49a245eed00b description jailops jail=web/nginx net=lan (jail side)
