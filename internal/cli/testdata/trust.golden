$ jailops project create web
project/web created

$ jailops cert enroll laptop --role operator --projects web --expires 15m
<trust-token>
! warning: this trust token is shown only once and works only once; hand it to the new client now.
! trust for laptop (operator, web) can be claimed until 2026-03-01 09:15:00 UTC

$ jailops cert enroll laptop --role operator --projects web
<trust-token>
! warning: this trust token is shown only once and works only once; hand it to the new client now.
! trust for laptop (operator, web) can be claimed until 2026-03-01 10:00:00 UTC

$ jailops cert enroll --role operator --global
! usage: accepts 1 arg(s), received 0
! hint: run 'jailops cert enroll --help' for usage
[exit 2]

$ jailops cert enroll ghost --role operator --projects nope
! invalid: project "nope" does not exist
[exit 2]

$ jailops cert list
NAME     KIND     ROLE       SCOPE   EXPIRES   FINGERPRINT
laptop   client   operator   web     never     <fingerprint>

$ jailops cert show laptop
metadata:
  name: laptop
  uuid: <uuid>
  scope: fleet
  generation: 1
  created_at: "2026-03-01T09:00:00Z"
  updated_at: "2026-03-01T09:00:00Z"
spec:
  fingerprint: <sha256>
  permission: operator
  kind: client
  projects:
    - web

$ jailops cert edit laptop -f <dir>/e.yaml
certificate/laptop updated

$ jailops whoami
User:        admin
Kind:        token
Role:        admin
Scope:       global
Remote:      adm (https://<addr>)
Project:     

$ jailops cert revoke laptop
! Revoke certificate "laptop"? [y/N]: 
! usage: confirmation required: standard input is not a terminal and gave no answer
! hint: answer y on standard input, or pass -y to confirm without a question
[exit 2]

$ jailops cert revoke -y laptop
certificate/laptop revoked

$ jailops cert list
! No certificates. Create one with: jailops cert create NAME

$ jailops cert revoke -y laptop
! not_found: certificate "laptop" not found
! hint: list them with 'jailops cert list'; check --project, --host and --remote too
[exit 4]

$ jailops sessions list
! No resources found.

$ jailops sessions revoke -y nosuch
! not_found: session "nosuch" not found
! hint: list them with 'jailops sessions list'; check --project, --host and --remote too
[exit 4]

