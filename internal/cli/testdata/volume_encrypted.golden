$ jailops jail create vault2 --image freebsd-15@stable --network lan --storage default
jail/vault2 created

$ jailops volume attach vault2 vault2 /srv/db
volume/vault2 attached to jail vault2

$ jailops volume attach vault2 vault /srv/other
