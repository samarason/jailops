# Managed by JailOps. Do not edit; changes are overwritten.
# anchor jailops/alpha/web
# the host's own addresses (a jail reaches none of them unless a rule says so)
table <host> persist
# what an allow rule to any does not reach: the host and the networks of other projects (name them to open them)
table <not_any> persist
table <jail_addrs> persist { 10.20.0.10, 2001:db8:1::100, fe80::2858:8aff:fe88:fcd2 }
block in quick on joe1a inet6 proto icmp6 from any to any icmp6-type { routeradv, redir }
pass in quick on joe1a inet6 proto icmp6 from :: to ff02::1:ff00:0/104 icmp6-type neighbrsol label "jo-f5191988cb09" keep state (if-bound)
block in quick on joe1a from ! <jail_addrs> to any
block in quick on joe1a inet6 proto icmp6 from any to ff02::/16 icmp6-type neighbradv
pass in quick on joe1a inet6 proto icmp6 from { 2001:db8:1::100, fe80::2858:8aff:fe88:fcd2 } to any icmp6-type { neighbrsol, neighbradv } label "jo-0b2bfbe47b93" keep state (if-bound)
pass in quick on joe1a inet6 proto icmp6 from { 2001:db8:1::100, fe80::2858:8aff:fe88:fcd2 } to ff02::/16 icmp6-type { listenrep, listendone, 143 } label "jo-e8ccd51232a6" keep state (if-bound)
pass in quick on joe1a inet6 proto icmp6 from { 2001:db8:1::100, fe80::2858:8aff:fe88:fcd2 } to any icmp6-type { unreach, toobig, timex, paramprob } label "jo-3fecd63216b9" keep state (if-bound)
block out quick on joe1a inet6 proto icmp6 from any to any icmp6-type { redir, routeradv }
pass out quick on joe1a inet6 proto icmp6 from any to { 2001:db8:1::100, fe80::2858:8aff:fe88:fcd2, ff02::1:ff00:100, ff02::1:ff88:fcd2 } icmp6-type { neighbrsol, neighbradv } label "jo-dbfa124e523e" keep state (if-bound)
pass out quick on joe1a inet6 proto icmp6 from any to any icmp6-type { unreach, toobig, timex, paramprob } label "jo-9018ced50445" keep state (if-bound)
block drop out quick on joe1a from any to ! <jail_addrs>
block drop out quick on joe1a inet proto icmp from any to any icmp-type redir
# policy web
# the host: closed unless a rule above opened it; ping and the network's resolver stay open
pass in quick on joe1a inet proto icmp from any to <host> label "jo-19e10e0f6b33" keep state (if-bound)
pass in quick on joe1a inet6 proto icmp6 from any to <host> label "jo-8c3ce8d48669" keep state (if-bound)
block drop in quick on joe1a from any to <host>
# defaults: final (quick), so that no rule of the host's own pf.conf after the anchor line changes them
block drop out quick on joe1a all
block drop in quick on joe1a all
