$ jailops firewall address-set create office --address 192.0.2.0/24 --address 198.51.100.7
address set/office created

$ jailops firewall address-set create hq --comment the office
address set/hq created

$ jailops firewall address-set add hq 192.0.2.9 --comment the office network
address set/hq: added 192.0.2.9

$ jailops firewall address-set add hq 192.0.2.9 192.0.2.10
address set/hq: added 192.0.2.10 (already a member: 192.0.2.9)

$ jailops firewall address-set add hq not-an-address
! usage: "not-an-address" is not a valid address, or a reference: host, jail:NAME, set:NAME or tag:NAME
! hint: run 'jailops firewall address-set add --help' for usage
[exit 2]

$ jailops firewall address-set show hq -o yaml
metadata:
  name: hq
  uuid: <uuid>
  project: main
  scope: fleet
  generation: 3
  created_at: "2026-03-01T09:00:00Z"
  updated_at: "2026-03-01T09:00:00Z"
spec:
  comment: the office
  addresses:
    - address: 192.0.2.9
      comment: the office network
    - address: 192.0.2.10

$ jailops firewall address-set show hq
Address set hq
  Comment:  the office
  Age:      3h

MEMBER       COMMENT
192.0.2.9    the office network
192.0.2.10   -

$ jailops firewall address-set remove hq 192.0.2.77
! usage: 192.0.2.77 is not a member of address set hq (jailops firewall address-set show hq)
! hint: run 'jailops firewall address-set remove --help' for usage
[exit 2]

$ jailops firewall address-set remove hq 192.0.2.10
address set/hq: removed 192.0.2.10

$ jailops firewall policy create documented --default-in deny --default-out allow --comment the public web server
firewall policy/documented created

$ jailops firewall rule add documented in --action allow --proto tcp --port 80,443 --comment the site
firewall policy/documented: rule 1 added: allow in tcp port 80,443

$ jailops firewall rule add documented in --action allow --proto tcp --from set:hq --port 22 --comment ssh from the office
firewall policy/documented: rule 2 added: allow in tcp from set:hq port 22

$ jailops firewall policy show documented -o yaml
metadata:
  name: documented
  uuid: <uuid>
  project: main
  scope: fleet
  generation: 3
  created_at: "2026-03-01T09:00:00Z"
  updated_at: "2026-03-01T09:00:00Z"
spec:
  comment: the public web server
  default_in: deny
  default_out: allow
  rules:
    - comment: the site
      action: allow
      direction: in
      proto: tcp
      ports:
        - "80"
        - "443"
    - comment: ssh from the office
      action: allow
      direction: in
      proto: tcp
      from:
        - set:hq
      ports:
        - "22"

$ jailops firewall policy show documented
Firewall policy documented
  Comment:      the public web server
  Default in:   deny
  Default out:  allow
  Age:          3h

#   RULE                               COMMENT
1   allow in tcp port 80,443           the site
2   allow in tcp from set:hq port 22   ssh from the office

$ jailops firewall policy create switchable
firewall policy/switchable created

$ jailops firewall rule add switchable in --action allow --proto tcp --port 80 --comment the site
firewall policy/switchable: rule 1 added: allow in tcp port 80

$ jailops firewall rule add switchable in --action allow --proto tcp --port 22 --disabled --comment ssh, switched off
firewall policy/switchable: rule 2 added: allow in tcp port 22 disabled

$ jailops firewall rule add switchable in --action deny --proto tcp --port 23 --disabled
firewall policy/switchable: rule 3 added: deny in tcp port 23 disabled
! note: the rule has no comment; say why it is there with: jailops firewall rule edit switchable 3 --comment TEXT

$ jailops firewall policy show switchable
Firewall policy switchable
  Default in:   deny
  Default out:  allow
  Age:          3h

#   RULE                            COMMENT
1   allow in tcp port 80            the site
2   allow in tcp port 22 disabled   ssh, switched off
3   deny in tcp port 23 disabled    -

$ jailops firewall policy show switchable -o yaml
metadata:
  name: switchable
  uuid: <uuid>
  project: main
  scope: fleet
  generation: 4
  created_at: "2026-03-01T09:00:00Z"
  updated_at: "2026-03-01T09:00:00Z"
spec:
  default_in: deny
  default_out: allow
  rules:
    - comment: the site
      action: allow
      direction: in
      proto: tcp
      ports:
        - "80"
    - comment: ssh, switched off
      action: allow
      direction: in
      proto: tcp
      ports:
        - "22"
      disabled: true
    - action: deny
      direction: in
      proto: tcp
      ports:
        - "23"
      disabled: true

$ jailops firewall policy create nodefaults
firewall policy/nodefaults created

$ jailops firewall policy create web --default-in deny --default-out allow
firewall policy/web created

$ jailops firewall rule add web in --action allow --proto tcp --port 80,443
firewall policy/web: rule 1 added: allow in tcp port 80,443
! note: the rule has no comment; say why it is there with: jailops firewall rule edit web 1 --comment TEXT

$ jailops firewall rule add web in --action allow --proto tcp --from set:office --port 22 --log
firewall policy/web: rule 2 added: allow in tcp from set:office port 22 log
! note: the rule has no comment; say why it is there with: jailops firewall rule edit web 2 --comment TEXT

$ jailops firewall rule add web in --action allow --proto tcp --redirect 8080:80
firewall policy/web: rule 3 added: allow in tcp rdr 8080:80
! note: the rule has no comment; say why it is there with: jailops firewall rule edit web 3 --comment TEXT

$ jailops firewall rule add web in
firewall policy/web: rule 4 added: allow in
! note: the rule has no comment; say why it is there with: jailops firewall rule edit web 4 --comment TEXT

$ jailops firewall rule add web in --action allow --proto bogus
! invalid: proto "bogus" must be tcp, udp, icmp or icmp6
[exit 2]

