$ jailops network create web --ipv4 10.50.0.1/24 --ipv6 fd50::1/64
network/web created

$ jailops network create bad --ipv4 10.50.0.1/24 --subnet 10.1.0.0/24
! usage: --ipv4 replaces --subnet, --gateway and --range: use one form
! hint: run 'jailops network create --help' for usage
[exit 2]

$ jailops network create bad --ipv4 nonsense
! usage: --ipv4 "nonsense" must look like 10.50.0.1/24
! hint: run 'jailops network create --help' for usage
[exit 2]

$ jailops network show web -o yaml
metadata:
  name: web
  uuid: <uuid>
  scope: fleet
  generation: 1
  created_at: "2026-03-01T09:00:00Z"
  updated_at: "2026-03-01T09:00:00Z"
spec:
  ipv4:
    subnet: 10.50.0.0/24
    gateway: 10.50.0.1
    range: 10.50.0.2-10.50.0.254
  ipv6:
    mode: routed
    subnet: fd50::/64
    range: fd50::1-fd50::ffff
status:
  free: 253

$ jailops storage create fast --dataset tank/fast --compression zstd
storage/fast created

$ jailops storage create nodataset
! usage: --dataset is required (or use -f FILE)
! hint: run 'jailops storage create --help' for usage
[exit 2]

$ jailops storage create bad --dataset nodash
! invalid: dataset "nodash" must look like pool/dataset
[exit 2]

$ jailops storage list
NAME      DATASET        POOL   HEALTH   USED      AVAILABLE
default   tank/jailops   tank   ONLINE   1.0 GiB   1023.0 GiB
fast      tank/fast      tank   ONLINE   1.0 GiB   1023.0 GiB

$ jailops storage show fast -o name
fast

$ jailops project create web --comment front end
project/web created

$ jailops network grant web --project web
network/web granted to project web

$ jailops storage grant fast --project web --quota 500G
storage/fast granted to project web

$ jailops project set web --max-jails 2 --max-memory 8G
project/web updated

$ jailops project show web
Project web
  Comment:     front end
  Hosts:       this host
  Networks:    web
  Storage:     fast (quota 500G)
  Firewall:    none
  Images:      any
  Age:         3h

Usage
  Jails:       0 of 2
  CPU:         0 cores (no quota)
  Memory:      0 B of 8G
  Disk:        0 B
  Addresses:   0 (no quota)

$ jailops project list
    NAME   HOSTS   NETWORKS   STORAGE   JAILS   COMMENT
*   main   -       lan        default   0       -
    web    -       web        fast      0/2     front end

$ jailops network grant lan --project web
! conflict: network lan is already granted to project main
[exit 5]

$ jailops network grant lan
network/lan granted to project main

$ jailops network revoke web --project web
network/web revoked from project web

$ jailops network grant web --project web
network/web granted to project web

$ jailops storage revoke fast --project web
storage/fast revoked from project web

$ jailops storage grant fast --project web --quota 500G
storage/fast granted to project web

$ jailops create nginx --project web --image freebsd-15@stable --memory 1G --cpu 1 --network web --storage fast
jail/nginx created

$ jailops list --project web
NAME    STATE     IMAGE               GEN   ADDRESSES           AUTOSTART   AGE
nginx   stopped   freebsd-15@stable   g1    10.50.0.2,fd50::1   -           3h

$ jailops list
! No jails in project main. Create one with: jailops jail create NAME --image IMAGE --network NETWORK --storage STORAGE

$ jailops list --project nowhere
! not_found: project "nowhere" not found
! hint: list them with 'jailops project list'; check --project, --host and --remote too
[exit 4]

