# Managed by JailOps. Do not edit; changes are overwritten.
# anchor jailops/alpha/web
# tags: tier-1 web
# the host's own addresses (a jail reaches none of them unless a rule says so)
table <host> persist
# what an allow rule to any does not reach: the host and the networks of other projects (name them to open them)
table <not_any> persist
table <jail_addrs> persist { 10.20.0.10, 2001:db8:1::100, fe80::/10 }
block in quick on jo0123456789a0a inet6 proto icmp6 from any to any icmp6-type { routeradv, redir }
pass in quick on jo0123456789a0a inet6 proto icmp6 from :: to ff02::1:ff00:0/104 icmp6-type neighbrsol label "jo-b1a9dbe5125f" keep state (if-bound)
block in quick on jo0123456789a0a from ! <jail_addrs> to any
block in quick on jo0123456789a0a inet6 proto icmp6 from any to ff02::/16 icmp6-type neighbradv
pass in quick on jo0123456789a0a inet6 proto icmp6 from { 2001:db8:1::100, fe80::/10 } to any icmp6-type { neighbrsol, neighbradv } label "jo-d6d162f1da58" keep state (if-bound)
pass in quick on jo0123456789a0a inet6 proto icmp6 from { 2001:db8:1::100, fe80::/10 } to ff02::/16 icmp6-type { listenrep, listendone, 143 } label "jo-0e3e7868a4f4" keep state (if-bound)
pass in quick on jo0123456789a0a inet6 proto icmp6 from { 2001:db8:1::100, fe80::/10 } to any icmp6-type { unreach, toobig, timex, paramprob } label "jo-9d40966a2a0a" keep state (if-bound)
block out quick on jo0123456789a0a inet6 proto icmp6 from any to any icmp6-type { redir, routeradv }
pass out quick on jo0123456789a0a inet6 proto icmp6 from any to { 2001:db8:1::100, fe80::/10, ff02::1:ff00:0/104 } icmp6-type { neighbrsol, neighbradv } label "jo-f7ca57c47081" keep state (if-bound)
pass out quick on jo0123456789a0a inet6 proto icmp6 from any to any icmp6-type { unreach, toobig, timex, paramprob } label "jo-0f240135318b" keep state (if-bound)
block drop out quick on jo0123456789a0a from any to ! <jail_addrs>
block drop out quick on jo0123456789a0a inet proto icmp from any to any icmp-type redir
# project policy floor
#   for every jail
# rule 1: ssh
pass out quick on jo0123456789a0a inet proto tcp from any to 10.20.0.10 port 22 label "jo-a652125cc1ad" keep state (if-bound)
pass out quick on jo0123456789a0a inet6 proto tcp from any to 2001:db8:1::100 port 22 label "jo-2a89444f616d" keep state (if-bound)
# project policy monitoring
# rule 1: metrics
pass out quick on jo0123456789a0a inet proto tcp from any to 10.20.0.10 port 9100 label "jo-2279032682ec" keep state (if-bound)
pass out quick on jo0123456789a0a inet6 proto tcp from any to 2001:db8:1::100 port 9100 label "jo-e66852739639" keep state (if-bound)
# policy app-web
# rule 1: access a
pass out quick on jo0123456789a0a inet proto tcp from any to 10.20.0.10 port 5432 label "jo-a61b224263b7" keep state (if-bound)
pass out quick on jo0123456789a0a inet6 proto tcp from any to 2001:db8:1::100 port 5432 label "jo-172d17f43f73" keep state (if-bound)
# policy postgres
#   who may reach PostgreSQL
# rule 1: from the set
pass out quick on jo0123456789a0a inet proto tcp from any to 10.20.0.10 port 5432 label "jo-4159efa35ccd" keep state (if-bound)
pass out quick on jo0123456789a0a inet6 proto tcp from any to 2001:db8:1::100 port 5432 label "jo-0fa9eedcab1e" keep state (if-bound)
# rule 2: second
pass out quick on jo0123456789a0a inet proto tcp from any to 10.20.0.10 port 5433 label "jo-d5626db9d57c" keep state (if-bound)
pass out quick on jo0123456789a0a inet6 proto tcp from any to 2001:db8:1::100 port 5433 label "jo-a374bb6666bb" keep state (if-bound)
# policy ssh-office
# rule 1: office
pass out quick on jo0123456789a0a inet proto tcp from any to 10.20.0.10 port 22 label "jo-16744681eef9" keep state (if-bound)
pass out quick on jo0123456789a0a inet6 proto tcp from any to 2001:db8:1::100 port 22 label "jo-ef96f9f4b0b0" keep state (if-bound)
# proxy devices
# rule 1: proxy web
pass out quick on jo0123456789a0a inet proto tcp from any to 10.20.0.10 port 80 label "jo-9f03d18434a7" keep state (if-bound)
pass out quick on jo0123456789a0a inet6 proto tcp from any to 2001:db8:1::100 port 80 label "jo-00b6c1b4ebd9" keep state (if-bound)
# the host: closed unless a rule above opened it; ping and the network's resolver stay open
pass in quick on jo0123456789a0a inet proto icmp from any to <host> label "jo-eaaf08bc268a" keep state (if-bound)
pass in quick on jo0123456789a0a inet6 proto icmp6 from any to <host> label "jo-cf379d09e79b" keep state (if-bound)
block drop in quick on jo0123456789a0a from any to <host>
# defaults: final (quick), so that no rule of the host's own pf.conf after the anchor line changes them
block drop out quick on jo0123456789a0a all
pass in quick on jo0123456789a0a all label "jo-3562b0b4cd79" keep state (if-bound)
